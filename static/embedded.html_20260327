<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Data Copilot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --bg-base: #f4f5f7;
        --bg-surface: #fff;
        --bg-surface-raised: #f0f1f4;
        --bg-inset: #e8eaed;
        --bg-accent: #d97757;
        --bg-accent-hover: #c4623f;
        --bg-accent-subtle: #fdf4f0;
        --bg-accent-glow: rgba(217, 119, 87, 0.12);
        --bg-progress: #fef9f6;
        --bg-error: #fef2f2;
        --bg-user-bubble: #d97757;
        --bg-collapsed: #faf7f5;
        --bg-collapsed-hover: #f5efeb;
        --bg-cmd: #f8f8fa;
        --bg-cmd-hover: #eef0f4;
        --text-primary: #18181b;
        --text-secondary: #52525b;
        --text-tertiary: #a1a1aa;
        --text-inverse: #fff;
        --text-accent: #c4623f;
        --text-progress: #9a5a3a;
        --text-error: #991b1b;
        --text-cmd: #6b6b76;
        --text-cmd-key: #9f6b56;
        --border-default: #e4e4e7;
        --border-subtle: #f0f0f3;
        --border-accent: #f5d0c0;
        --border-focus: #d97757;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 8px 20px rgba(0, 0, 0, 0.1);
        --radius-xs: 4px;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-full: 9999px;
        --font-sans:
          "Noto Sans KR", -apple-system, BlinkMacSystemFont, system-ui,
          sans-serif;
        --font-mono: "JetBrains Mono", "Fira Code", monospace;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --t-fast: 120ms;
        --t-normal: 200ms;
        --t-slow: 350ms;
        color-scheme: light;
      }
      [data-theme="dim"] {
        --bg-base: #2b2a27;
        --bg-surface: #333230;
        --bg-surface-raised: #3a3936;
        --bg-inset: #42413e;
        --bg-accent: #d97757;
        --bg-accent-hover: #e8906e;
        --bg-accent-subtle: #3d302a;
        --bg-accent-glow: rgba(217, 119, 87, 0.16);
        --bg-progress: #38302a;
        --bg-error: #3d2a2a;
        --bg-user-bubble: #d97757;
        --bg-collapsed: #37352f;
        --bg-collapsed-hover: #3e3c36;
        --bg-cmd: #353430;
        --bg-cmd-hover: #3d3c38;
        --text-primary: #e8e6e0;
        --text-secondary: #b0ada5;
        --text-tertiary: #7a7770;
        --text-inverse: #fff;
        --text-accent: #e8906e;
        --text-progress: #e8a98e;
        --text-error: #f87171;
        --text-cmd: #8a8780;
        --text-cmd-key: #d4896a;
        --border-default: #46443f;
        --border-subtle: #3a3936;
        --border-accent: #503d32;
        --border-focus: #d97757;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.25);
        --shadow-lg: 0 8px 20px rgba(0, 0, 0, 0.35);
        color-scheme: dark;
      }
      [data-theme="dark"] {
        --bg-base: #0e0e10;
        --bg-surface: #19191d;
        --bg-surface-raised: #222226;
        --bg-inset: #2a2a2f;
        --bg-accent: #d97757;
        --bg-accent-hover: #e8906e;
        --bg-accent-subtle: #2a1f1a;
        --bg-accent-glow: rgba(217, 119, 87, 0.2);
        --bg-progress: #1e1814;
        --bg-error: #2a1515;
        --bg-user-bubble: #d97757;
        --bg-collapsed: #1e1b19;
        --bg-collapsed-hover: #272220;
        --bg-cmd: #1e1e22;
        --bg-cmd-hover: #28282d;
        --text-primary: #ececef;
        --text-secondary: #a0a0a8;
        --text-tertiary: #5c5c66;
        --text-inverse: #fff;
        --text-accent: #e8906e;
        --text-progress: #e8a98e;
        --text-error: #f87171;
        --text-cmd: #78787f;
        --text-cmd-key: #d4896a;
        --border-default: #2c2c31;
        --border-subtle: #222226;
        --border-accent: #3d2a22;
        --border-focus: #d97757;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 8px 20px rgba(0, 0, 0, 0.6);
        color-scheme: dark;
      }
      body {
        font-family: var(--font-sans);
        background: var(--bg-base);
        height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--text-primary);
        -webkit-font-smoothing: antialiased;
        transition:
          background var(--t-slow) var(--ease-out),
          color var(--t-slow) var(--ease-out);
      }
      .header {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-default);
        padding: 0 20px;
        height: 54px;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 10;
        transition:
          background var(--t-slow) var(--ease-out),
          border-color var(--t-slow) var(--ease-out);
      }
      .header-logo {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
      }
      .header-logo svg {
        width: 24px;
        height: 24px;
      }
      .header-info {
        flex: 1;
        min-width: 0;
      }
      .header-title {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.025em;
      }
      .header-subtitle {
        font-size: 11px;
        color: var(--text-tertiary);
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .header-status {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--text-tertiary);
        padding-right: 4px;
      }
      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-tertiary);
        transition: background var(--t-normal);
      }
      .status-dot.connected {
        background: #22c55e;
      }
      .status-dot.connecting {
        background: #f59e0b;
        animation: pulseDot 1.4s infinite;
      }
      @keyframes pulseDot {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }
      .theme-toggle {
        width: 34px;
        height: 34px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-default);
        background: var(--bg-surface-raised);
        color: var(--text-secondary);
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: all var(--t-fast);
      }
      .theme-toggle:hover {
        background: var(--bg-inset);
        color: var(--text-primary);
      }
      .theme-toggle svg {
        width: 15px;
        height: 15px;
      }
      .theme-toggle .icon-sun {
        display: none;
      }
      .theme-toggle .icon-moon {
        display: block;
      }
      .theme-toggle .icon-dim {
        display: none;
      }
      [data-theme="dim"] .theme-toggle .icon-sun {
        display: none;
      }
      [data-theme="dim"] .theme-toggle .icon-moon {
        display: none;
      }
      [data-theme="dim"] .theme-toggle .icon-dim {
        display: block;
      }
      [data-theme="dark"] .theme-toggle .icon-sun {
        display: block;
      }
      [data-theme="dark"] .theme-toggle .icon-moon {
        display: none;
      }
      [data-theme="dark"] .theme-toggle .icon-dim {
        display: none;
      }
      .chat-container {
        flex: 1;
        overflow-y: auto;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        background: var(--bg-base);
        transition: background var(--t-slow) var(--ease-out);
      }
      .chat-container::-webkit-scrollbar {
        width: 5px;
      }
      .chat-container::-webkit-scrollbar-track {
        background: transparent;
      }
      .chat-container::-webkit-scrollbar-thumb {
        background: var(--border-default);
        border-radius: 3px;
      }
      .welcome {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        padding: 40px 20px;
        animation: fadeUp 0.6s var(--ease-out);
      }
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .welcome-logo {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        margin-bottom: 20px;
      }
      .welcome-logo svg {
        width: 48px;
        height: 48px;
      }
      .welcome h2 {
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 6px;
      }
      .welcome p {
        font-size: 13.5px;
        color: var(--text-secondary);
        margin-bottom: 28px;
      }
      .examples {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        max-width: 460px;
        width: 100%;
      }
      .example-btn {
        padding: 11px 14px;
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 12.5px;
        font-family: var(--font-sans);
        text-align: left;
        line-height: 1.5;
        transition: all var(--t-fast);
      }
      .example-btn:hover {
        border-color: var(--border-accent);
        background: var(--bg-accent-subtle);
        color: var(--text-accent);
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
      }
      .message-row {
        display: flex;
        gap: 10px;
        max-width: 700px;
        width: 100%;
        margin: 0 auto;
        animation: msgSlide 0.3s var(--ease-out);
      }
      @keyframes msgSlide {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .message-row.user {
        justify-content: flex-end;
        padding-left: 48px;
      }
      .message-row.assistant {
        justify-content: flex-start;
      }
      .message-row.system {
        justify-content: center;
      }
      .msg-avatar {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        margin-top: 3px;
      }
      .msg-avatar svg {
        width: 22px;
        height: 22px;
      }
      .msg-content {
        max-width: 88%;
        min-width: 48px;
      }
      .msg-bubble {
        padding: 10px 15px;
        border-radius: var(--radius-md);
        line-height: 1.7;
        font-size: 14px;
        white-space: pre-wrap;
        word-break: break-word;
      }
      .msg-bubble.user-bubble {
        background: var(--bg-user-bubble);
        color: var(--text-inverse);
        border-bottom-right-radius: var(--radius-xs);
      }
      .msg-bubble.bot-bubble {
        background: var(--bg-surface);
        color: var(--text-primary);
        border-bottom-left-radius: var(--radius-xs);
        border: 1px solid var(--border-default);
        transition:
          background var(--t-slow) var(--ease-out),
          border-color var(--t-slow) var(--ease-out);
      }
      .msg-bubble.system-bubble {
        background: var(--bg-surface-raised);
        color: var(--text-secondary);
        font-size: 12.5px;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-default);
        font-family: var(--font-mono);
        line-height: 1.6;
      }
      .streaming-cursor {
        display: inline-block;
        width: 2px;
        height: 1.1em;
        background: var(--bg-accent);
        margin-left: 2px;
        vertical-align: text-bottom;
        border-radius: 1px;
        animation: blink 0.75s step-end infinite;
      }
      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }
      .thinking-indicator {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0 8px;
      }
      .thinking-logo-wrap {
        width: 32px;
        height: 32px;
        position: relative;
        display: grid;
        place-items: center;
      }
      .thinking-logo-wrap svg {
        width: 22px;
        height: 22px;
        position: relative;
        z-index: 1;
        animation: thinkBreathe 2.4s var(--ease-out) infinite;
      }
      .thinking-glow {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          var(--bg-accent-glow) 0%,
          transparent 70%
        );
        animation: glowPulse 2.4s var(--ease-out) infinite;
      }
      .thinking-ring {
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 1.5px solid var(--bg-accent);
        opacity: 0;
        animation: ringExpand 2.4s var(--ease-out) infinite;
      }
      @keyframes thinkBreathe {
        0% {
          transform: scale(1);
          opacity: 0.85;
        }
        50% {
          transform: scale(1.1);
          opacity: 1;
        }
        100% {
          transform: scale(1);
          opacity: 0.85;
        }
      }
      @keyframes glowPulse {
        0% {
          transform: scale(0.7);
          opacity: 0;
        }
        40% {
          transform: scale(1.5);
          opacity: 0.7;
        }
        100% {
          transform: scale(0.7);
          opacity: 0;
        }
      }
      @keyframes ringExpand {
        0% {
          transform: scale(0.8);
          opacity: 0.6;
        }
        100% {
          transform: scale(2);
          opacity: 0;
        }
      }
      .thinking-text-wrap {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }
      .thinking-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-accent);
      }
      .thinking-sub {
        font-size: 11px;
        color: var(--text-tertiary);
      }
      .thinking-dots::after {
        content: "";
        display: inline;
        animation: dots 1.5s steps(4, end) infinite;
      }
      @keyframes dots {
        0% {
          content: "";
        }
        25% {
          content: ".";
        }
        50% {
          content: "..";
        }
        75% {
          content: "...";
        }
      }
      .progress-block {
        margin-bottom: 6px;
      }
      .progress-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: var(--radius-sm);
        background: var(--bg-collapsed);
        border: 1px solid var(--border-default);
        cursor: pointer;
        user-select: none;
        transition: all var(--t-fast);
      }
      .progress-summary:hover {
        background: var(--bg-collapsed-hover);
      }
      .progress-summary .summary-icon {
        width: 16px;
        height: 16px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
      }
      .progress-summary .summary-icon svg {
        width: 14px;
        height: 14px;
      }
      .progress-summary .summary-text {
        flex: 1;
        font-size: 12px;
        color: var(--text-tertiary);
        font-weight: 500;
      }
      .progress-summary .summary-chevron {
        width: 16px;
        height: 16px;
        display: grid;
        place-items: center;
        color: var(--text-tertiary);
        transition: transform var(--t-normal) var(--ease-out);
      }
      .progress-summary .summary-chevron svg {
        width: 14px;
        height: 14px;
      }
      .progress-block.expanded .summary-chevron {
        transform: rotate(180deg);
      }
      .progress-detail {
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition:
          max-height var(--t-slow) var(--ease-out),
          opacity var(--t-normal) var(--ease-out),
          margin var(--t-slow) var(--ease-out);
        margin-top: 0;
      }
      .progress-block.expanded .progress-detail {
        max-height: 300px;
        opacity: 1;
        margin-top: 6px;
      }
      .progress-detail-inner {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 6px 10px;
        border-left: 2px solid var(--border-accent);
      }
      .progress-live {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .progress-step {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: var(--text-secondary);
        padding: 3px 0;
      }
      .progress-step .step-icon {
        width: 18px;
        height: 18px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
      }
      .progress-step.active .step-icon svg {
        animation: spinStep 0.9s linear infinite;
        color: var(--text-accent);
      }
      .progress-step.active {
        color: var(--text-accent);
        font-weight: 500;
      }
      .progress-step.done {
        color: var(--text-tertiary);
      }
      .progress-step.done .step-icon svg {
        color: #22c55e;
      }
      @keyframes spinStep {
        from {
          transform: rotate(0);
        }
        to {
          transform: rotate(360deg);
        }
      }
      .viz-container {
        margin-top: 10px;
        padding: 16px;
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        text-align: center;
        overflow: hidden;
        transition:
          background var(--t-slow),
          border-color var(--t-slow);
      }
      .viz-container svg {
        max-width: 100%;
        height: auto;
      }
      .viz-title {
        font-size: 11.5px;
        color: var(--text-tertiary);
        margin-bottom: 10px;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .viz-actions {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        justify-content: center;
      }
      .viz-actions button {
        padding: 5px 16px;
        font-size: 11.5px;
        font-family: var(--font-sans);
        background: var(--bg-accent-subtle);
        border: 1px solid var(--border-accent);
        border-radius: var(--radius-full);
        cursor: pointer;
        color: var(--text-accent);
        font-weight: 500;
        transition: all var(--t-fast);
      }
      .viz-actions button:hover {
        background: var(--bg-accent-glow);
      }
      .status-banner {
        max-width: 700px;
        width: 100%;
        margin: 4px auto;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        font-size: 12.5px;
        text-align: center;
        animation: fadeUp 0.25s var(--ease-out);
      }
      .status-banner.status {
        background: var(--bg-progress);
        color: var(--text-progress);
      }
      .status-banner.error {
        background: var(--bg-error);
        color: var(--text-error);
      }
      .cmd-popup {
        position: absolute;
        bottom: 100%;
        left: 0;
        right: 0;
        margin-bottom: 6px;
        background: var(--bg-surface);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        z-index: 20;
        animation: cmdUp 0.15s var(--ease-out);
      }
      @keyframes cmdUp {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .cmd-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        transition: background var(--t-fast);
      }
      .cmd-item:hover,
      .cmd-item.active {
        background: var(--bg-cmd-hover);
      }
      .cmd-item-icon {
        width: 28px;
        height: 28px;
        border-radius: var(--radius-xs);
        background: var(--bg-cmd);
        display: grid;
        place-items: center;
        font-size: 14px;
        flex-shrink: 0;
      }
      .cmd-item-text {
        flex: 1;
        min-width: 0;
      }
      .cmd-item-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        font-family: var(--font-mono);
      }
      .cmd-item-desc {
        font-size: 11.5px;
        color: var(--text-cmd);
        margin-top: 1px;
      }
      .cmd-item-key {
        font-size: 10px;
        font-family: var(--font-mono);
        color: var(--text-cmd-key);
        background: var(--bg-cmd);
        border: 1px solid var(--border-default);
        padding: 2px 6px;
        border-radius: 3px;
        flex-shrink: 0;
      }
      .input-area {
        padding: 12px 16px 16px;
        background: var(--bg-surface);
        border-top: 1px solid var(--border-default);
        transition:
          background var(--t-slow) var(--ease-out),
          border-color var(--t-slow) var(--ease-out);
      }
      .input-wrapper {
        max-width: 700px;
        margin: 0 auto;
        display: flex;
        gap: 8px;
        align-items: center;
        position: relative;
      }
      .input-wrapper input {
        flex: 1;
        padding: 11px 18px;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-full);
        font-size: 13.5px;
