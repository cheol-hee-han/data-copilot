    <script>
      (function () {
        "use strict";
        var CS =
            '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z" fill="#D97757" fill-rule="nonzero"/></svg>',
          IS =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 2v4m0 12v4m-7.07-15.07l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>',
          IC =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
          IV =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';

        /* 1. Theme */
        var TM = (function () {
          var K = "dc-theme";
          function init() {
            try {
              var s = localStorage.getItem(K);
              if (s) {
                ap(s);
                return;
              }
            } catch (e) {}
            ap(
              matchMedia("(prefers-color-scheme:dark)").matches
                ? "dim"
                : "light",
            );
            matchMedia("(prefers-color-scheme:dark)").addEventListener(
              "change",
              function (e) {
                var sv = null;
                try {
                  sv = localStorage.getItem(K);
                } catch (x) {}
                if (!sv) ap(e.matches ? "dim" : "light");
              },
            );
          }
          function ap(t) {
            document.documentElement.setAttribute("data-theme", t);
          }
          function toggle() {
            var c =
              document.documentElement.getAttribute("data-theme") || "light";
            var n = c === "light" ? "dim" : c === "dim" ? "dark" : "light";
            ap(n);
            try {
              localStorage.setItem(K, n);
            } catch (e) {}
          }
          return { init: init, toggle: toggle };
        })();

        /* 2. MessageStore */
        var MS = (function () {
          var _m = new Map(),
            _n = 0,
            SK = "dc-hist";
          function create(role, text, x) {
            x = x || {};
            var id = "msg-" + Date.now() + "-" + ++_n;
            var msg = {
              id: id,
              role: role,
              text: text || "",
              status: x.status || "done",
              progress: x.progress || [],
              visualization: x.visualization || null,
              showThinking: x.showThinking || false,
              thinkingLabel: x.thinkingLabel || "",
              progressCollapsed: false,
              progressStartTime: null,
              progressElapsed: null,
              timestamp: Date.now(),
            };
            _m.set(id, msg);
            _persist();
            return msg;
          }
          function get(id) {
            return _m.get(id) || null;
          }
          function update(id, p) {
            var m = _m.get(id);
            if (!m) return null;
            Object.assign(m, p);
            return m;
          }
          function clear() {
            _m.clear();
            _n = 0;
            _persist();
          }
          function allMessages() {
            return Array.from(_m.values());
          }
          function getSummary() {
            return allMessages()
              .filter(function (m) {
                return m.role === "user" || (m.role === "assistant" && m.text);
              })
              .map(function (m) {
                return {
                  role: m.role,
                  text: m.text.length > 80 ? m.text.slice(0, 80) + "…" : m.text,
                  time: m.timestamp,
                };
              });
          }
          function _persist() {
            try {
              var d = allMessages()
                .filter(function (m) {
                  return (
                    m.role === "user" || (m.role === "assistant" && m.text)
                  );
                })
                .map(function (m) {
                  return { role: m.role, text: m.text, time: m.timestamp };
                });
              sessionStorage.setItem(SK, JSON.stringify(d));
            } catch (e) {}
          }
          function loadPersisted() {
            try {
              var r = sessionStorage.getItem(SK);
              return r ? JSON.parse(r) : [];
            } catch (e) {
              return [];
            }
          }
          return {
            create: create,
            get: get,
            update: update,
            clear: clear,
            allMessages: allMessages,
            getSummary: getSummary,
            loadPersisted: loadPersisted,
          };
        })();

        /* 3. Renderer */
        var RD = (function () {
          function chat() {
            return document.getElementById("chatContainer");
          }
          function showWel() {
            var w = document.getElementById("welcomeScreen");
            if (w) w.style.display = "";
          }
          function hideWel() {
            var w = document.getElementById("welcomeScreen");
            if (w) w.style.display = "none";
          }
          function clearChat() {
            chat()
              .querySelectorAll(".message-row,.status-banner")
              .forEach(function (r) {
                r.remove();
              });
            showWel();
          }
          function ensureDOM(msg) {
            var row = chat().querySelector('[data-id="' + msg.id + '"]');
            if (row) return row;
            hideWel();
            row = document.createElement("div");
            row.className = "message-row " + msg.role;
            row.dataset.id = msg.id;
            if (msg.role === "assistant") {
              row.innerHTML =
                '<div class="msg-avatar">' +
                CS +
                '</div><div class="msg-content"><div class="thinking-slot"></div><div class="progress-block-slot"></div><div class="msg-bubble bot-bubble"></div><div class="viz-slot"></div></div>';
            } else if (msg.role === "system") {
              row.innerHTML =
                '<div class="msg-content" style="margin:0 auto"><div class="msg-bubble system-bubble"></div></div>';
            } else {
              row.innerHTML =
                '<div class="msg-content" style="margin-left:auto"><div class="msg-bubble user-bubble"></div></div>';
            }
            chat().appendChild(row);
            return row;
          }
          function render(msg) {
            var row = ensureDOM(msg),
              bub = row.querySelector(".msg-bubble");
            if (msg.status === "streaming") {
              bub.innerHTML =
                esc(msg.text) + '<span class="streaming-cursor"></span>';
            } else {
              bub.textContent = msg.text;
            }
            bub.style.display = !msg.text && msg.showThinking ? "none" : "";
            if (msg.role !== "assistant") {
              autoScroll();
              return;
            }
            renderTh(row, msg);
            renderPB(row, msg);
            if (msg.visualization) renderViz(row, msg.visualization);
            autoScroll();
          }
          function renderTh(row, msg) {
            var slot = row.querySelector(".thinking-slot");
            if (!msg.showThinking) {
              slot.innerHTML = "";
              return;
            }
            if (!slot.querySelector(".thinking-indicator")) {
              slot.innerHTML =
                '<div class="thinking-indicator"><div class="thinking-logo-wrap"><div class="thinking-glow"></div><div class="thinking-ring"></div>' +
                CS +
                '</div><div class="thinking-text-wrap"><span class="thinking-label"></span><span class="thinking-sub"><span class="thinking-dots"></span></span></div></div>';
            }
            slot.querySelector(".thinking-label").textContent =
              msg.thinkingLabel || "생각하는 중";
          }
          function renderPB(row, msg) {
            var slot = row.querySelector(".progress-block-slot");
            if (!msg.progress || !msg.progress.length) {
              slot.innerHTML = "";
              return;
            }
            if (msg.progressCollapsed) {
              var block = slot.querySelector(".progress-block");
              if (!block) {
                slot.innerHTML = "";
                block = document.createElement("div");
                block.className = "progress-block";
                block.innerHTML =
                  '<div class="progress-summary"><div class="summary-icon">' +
                  CS +
                  '</div><span class="summary-text"></span><div class="summary-chevron">' +
                  IV +
                  '</div></div><div class="progress-detail"><div class="progress-detail-inner"></div></div>';
                block
                  .querySelector(".progress-summary")
                  .addEventListener("click", function () {
                    block.classList.toggle("expanded");
                  });
                slot.appendChild(block);
              }
              var el = msg.progressElapsed,
                es = el != null ? " \u00b7 " + el.toFixed(1) + "초" : "";
              var dc = msg.progress.filter(function (s) {
                return s.status === "done";
              }).length;
              block.querySelector(".summary-text").textContent =
                "분석 완료 (" + dc + "단계" + es + ")";
              block.querySelector(".progress-detail-inner").innerHTML =
                msg.progress
                  .map(function (s) {
                    var d = s.status === "done";
                    return (
                      '<div class="progress-step ' +
                      (d ? "done" : "active") +
                      '"><span class="step-icon">' +
                      (d ? IC : IS) +
                      "</span><span>" +
                      esc(s.label) +
                      "</span></div>"
                    );
                  })
                  .join("");
              return;
            }
            var live = slot.querySelector(".progress-live");
            if (!live) {
              slot.innerHTML = "";
              live = document.createElement("div");
              live.className = "progress-live";
              slot.appendChild(live);
            }
            live.innerHTML = msg.progress
              .map(function (s) {
                var d = s.status === "done";
                return (
                  '<div class="progress-step ' +
                  (d ? "done" : "active") +
                  '"><span class="step-icon">' +
                  (d ? IC : IS) +
                  "</span><span>" +
                  esc(s.label) +
                  "</span></div>"
                );
              })
              .join("");
          }
          function renderViz(row, viz) {
            var slot = row.querySelector(".viz-slot");
            if (!slot) return;
            var vc = slot.querySelector(".viz-container");
            if (!vc) {
              vc = document.createElement("div");
              vc.className = "viz-container";
              vc.innerHTML =
                '<div class="viz-title"></div><div class="viz-svg-slot"></div><div class="viz-actions"><button onclick="App.downloadSVG(this)">SVG 다운로드</button></div>';
              slot.appendChild(vc);
            }
            if (viz.title)
              vc.querySelector(".viz-title").textContent = viz.title;
            if (viz.code)
              vc.querySelector(".viz-svg-slot").innerHTML = sanitizeSVG(
                viz.code,
              );
          }
          function showBanner(type, text) {
            hideWel();
            var el = document.createElement("div");
            el.className = "status-banner " + type;
            el.textContent = text;
            chat().appendChild(el);
            autoScroll();
            setTimeout(function () {
              el.remove();
            }, 5000);
          }
          return {
            ensureDOM: ensureDOM,
            render: render,
            showBanner: showBanner,
            hideWel: hideWel,
            showWel: showWel,
            clearChat: clearChat,
          };
        })();

        /* 4. StreamEngine */
        var SE = (function () {
          var _a = new Map();
          function streamText(id, full, opts) {
            opts = opts || {};
            cancel(id);
            var st = { cancelled: false };
            _a.set(id, st);
            var cs = opts.chunkSize || 3,
              iv = opts.interval || 20;
            return new Promise(function (res) {
              var p = 0,
                msg = MS.get(id);
              if (!msg) {
                res();
                return;
              }
              msg.text = "";
              msg.status = "streaming";
              (function tick() {
                if (st.cancelled || p >= full.length) {
                  msg.text = st.cancelled ? msg.text : full;
                  msg.status = "done";
                  RD.render(msg);
                  _a.delete(id);
                  res();
                  return;
                }
                p += cs;
                msg.text = full.slice(0, p);
                RD.render(msg);
                setTimeout(tick, iv);
              })();
            });
          }
          function appendChunk(id, ch) {
            var m = MS.get(id);
            if (!m) return;
            m.text += ch;
            m.status = "streaming";
            RD.render(m);
          }
          function finalize(id) {
            var m = MS.get(id);
            if (!m) return;
            m.status = "done";
            m.showThinking = false;
            RD.render(m);
          }
          function cancel(id) {
            var s = _a.get(id);
            if (s) s.cancelled = true;
          }
          function cancelAll() {
            _a.forEach(function (s) {
              s.cancelled = true;
            });
          }
          return {
            streamText: streamText,
            appendChunk: appendChunk,
            finalize: finalize,
            cancel: cancel,
            cancelAll: cancelAll,
          };
        })();

        /* 5. EventDispatcher */
        var ED = (function () {
          var _cur = null,
            _bt = null;
          function _cbt() {
            if (_bt) {
              clearTimeout(_bt);
              _bt = null;
            }
          }
          function _sbt() {
            _cbt();
            _bt = setTimeout(function () {
              if (!_cur) return;
              RD.showBanner("error", "서버 응답이 지연되고 있습니다.");
              _ffc();
              IC2.setBusy(false);
            }, 30000);
          }
          function _ffc() {
            if (!_cur) return;
            var p = MS.get(_cur);
            if (p) {
              SE.cancel(_cur);
              p.status = "done";
              p.showThinking = false;
              if (p.progress.length) {
                p.progress.forEach(function (s) {
                  s.status = "done";
                });
                p.progressCollapsed = true;
                p.progressElapsed = p.progressStartTime
                  ? (Date.now() - p.progressStartTime) / 1000
                  : null;
              }
              RD.render(p);
            }
            _cur = null;
          }
          function handle(data) {
            _cbt();
            switch (data.type) {
              case "response":
                return handleLegacy(data);
              case "stream":
                return handleStream(data);
              case "progress":
                return handleProgress(data);
              case "viz":
                return handleViz(data);
              case "status":
                return RD.showBanner("status", data.message || "");
              case "error":
                return handleError(data);
              default:
                if (data.message) return handleLegacy(data);
            }
          }
          async function handleLegacy(data) {
            _ffc();
            var msg = MS.create("assistant", "", {
              status: "streaming",
              showThinking: true,
              thinkingLabel: "데이터 분석 중",
            });
            msg.progressStartTime = Date.now();
            _cur = msg.id;
            RD.ensureDOM(msg);
            RD.render(msg);
            IC2.setBusy(true);
            var steps = [
              { label: "🔍 데이터 조회 중…", delay: 500 },
              { label: "🧠 분석 중…", delay: 600 },
              { label: "📊 결과 정리 중…", delay: 500 },
            ];
            for (var i = 0; i < steps.length; i++) {
              await sleep(steps[i].delay);
              if (_cur !== msg.id) return;
              var last = msg.progress[msg.progress.length - 1];
              if (last && last.status === "active") last.status = "done";
              msg.progress.push({ label: steps[i].label, status: "active" });
              RD.render(msg);
            }
            await sleep(250);
            if (_cur !== msg.id) return;
            msg.progress.forEach(function (s) {
              s.status = "done";
            });
            msg.showThinking = false;
            RD.render(msg);
            await SE.streamText(msg.id, data.message || "");
            if (_cur !== msg.id) return;
            msg.progressElapsed = (Date.now() - msg.progressStartTime) / 1000;
            msg.progressCollapsed = true;
            RD.render(msg);
            if (data.visualization) {
              msg.visualization = data.visualization;
              RD.render(msg);
            }
            _cur = null;
            _cbt();
            IC2.setBusy(false);
          }
          function handleStream(data) {
            if (data.action === "start") {
              _ffc();
              var msg = MS.create("assistant", "", {
                status: "streaming",
                showThinking: true,
                thinkingLabel: data.label || "생각하는 중",
              });
              msg.progressStartTime = Date.now();
              _cur = msg.id;
              RD.ensureDOM(msg);
              RD.render(msg);
              IC2.setBusy(true);
              return;
            }
            if (data.action === "chunk" && _cur) {
              var m = MS.get(_cur);
              if (m && m.showThinking) {
                m.showThinking = false;
                RD.render(m);
              }
              SE.appendChunk(_cur, data.text || "");
              return;
            }
            if (data.action === "end" && _cur) {
              var m2 = MS.get(_cur);
              if (m2) {
                SE.finalize(_cur);
                if (m2.progress.length) {
                  m2.progressElapsed =
                    (Date.now() - (m2.progressStartTime || Date.now())) / 1000;
                  m2.progressCollapsed = true;
                  RD.render(m2);
                }
              }
              _cur = null;
              _cbt();
              IC2.setBusy(false);
            }
          }
          function handleProgress(data) {
            if (!_cur) return;
            var msg = MS.get(_cur);
            if (!msg) return;
            if (data.action === "add") {
              var last = msg.progress[msg.progress.length - 1];
              if (last && last.status === "active") last.status = "done";
              msg.progress.push({ label: data.label, status: "active" });
            } else if (data.action === "done") {
              var l = msg.progress[msg.progress.length - 1];
              if (l) l.status = "done";
            } else if (data.action === "set") {
              msg.progress = (data.steps || []).map(function (s) {
                return { label: s.label, status: s.status || "active" };
              });
            }
            if (data.thinkingLabel !== undefined)
              msg.thinkingLabel = data.thinkingLabel;
            RD.render(msg);
          }
          function handleViz(data) {
            var id = data.messageId || _cur;
            if (!id) return;
            var msg = MS.get(id);
            if (!msg) return;
            msg.visualization = msg.visualization || {};
            if (data.title) msg.visualization.title = data.title;
            if (data.code) msg.visualization.code = data.code;
            RD.render(msg);
          }
          function handleError(data) {
            RD.showBanner("error", data.message || "오류가 발생했습니다.");
            _ffc();
            _cbt();
            IC2.setBusy(false);
          }
          function getCurrentId() {
            return _cur;
          }
          function startBusyTimer() {
            _sbt();
          }
          return {
            handle: handle,
            getCurrentId: getCurrentId,
            startBusyTimer: startBusyTimer,
          };
        })();

        /* 6. InputController */
        var IC2 = (function () {
          function setBusy(b) {
            document.getElementById("messageInput").disabled = b;
            document.getElementById("sendBtn").style.display = b
              ? "none"
              : "grid";
            document.getElementById("cancelBtn").style.display = b
              ? "grid"
              : "none";
            if (!b) document.getElementById("messageInput").focus();
          }
          return { setBusy: setBusy };
        })();

        /* 7. Connection */
        var CN = (function () {
          var sid = "session-" + Date.now(),
            ws = null,
            att = 0;
          function url() {
            return (
              (location.protocol === "https:" ? "wss" : "ws") +
              "://" +
              location.host +
              "/ws/" +
              sid
            );
          }
          function connect() {
            setStatus("connecting");
            ws = new WebSocket(url());
            ws.onopen = function () {
              att = 0;
              setStatus("connected");
            };
            ws.onmessage = function (e) {
              try {
                ED.handle(JSON.parse(e.data));
              } catch (err) {
                console.error(err);
              }
            };
            ws.onclose = function () {
              setStatus("disconnected");
              if (att < 5) {
                setTimeout(connect, 1000 * Math.pow(2, att));
                att++;
              }
            };
            ws.onerror = function (err) {
              console.error("[WS]", err);
            };
          }
          function send(t) {
            if (ws && ws.readyState === 1) {
              ws.send(t);
              return true;
            }
            return false;
          }
          function sendJSON(obj) {
            return send(JSON.stringify(obj));
          }
          function setStatus(s) {
            var d = document.getElementById("statusDot"),
              l = document.getElementById("statusLabel");
            d.className = "status-dot";
            if (s === "connected") {
              d.classList.add("connected");
              l.textContent = "연결됨";
            } else if (s === "connecting") {
              d.classList.add("connecting");
              l.textContent = "연결 중…";
            } else {
              l.textContent = "연결 끊김";
            }
          }
          return { connect: connect, send: send, sendJSON: sendJSON };
        })();

        /* 8. CommandManager */
        var CM = (function () {
          var CMDS = [
            {
              name: "/reset",
              desc: "대화 초기화 — 현재 대화를 모두 지웁니다",
              icon: "↺",
            },
            {
              name: "/history",
              desc: "대화 기록 — 이번 세션의 대화 요약을 표시합니다",
              icon: "⏱",
            },
          ];
          var _popup = null,
            _idx = 0,
            _flt = [];
          function inp() {
            return document.getElementById("messageInput");
          }
          function wrap() {
            return document.getElementById("inputWrapper");
          }
          function init() {
            inp().addEventListener("input", _onInput);
            inp().addEventListener("keydown", _onKey);
            document.addEventListener("click", function (e) {
              if (_popup && !wrap().contains(e.target)) _hide();
            });
          }
          function _onInput() {
            var v = inp().value;
            if (!v.startsWith("/") || v.includes(" ")) {
              _hide();
              return;
            }
            var q = v.toLowerCase();
            _flt = CMDS.filter(function (c) {
              return c.name.startsWith(q) && c.name !== q;
            });
            if (v === "/") {
              _flt = CMDS.slice();
            }
            if (_flt.length === 0) {
              _hide();
              return;
            }
            _idx = 0;
            _show();
          }
          function _onKey(e) {
            if (!_popup) {
              if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                App.sendMessage();
              }
              return;
            }
            if (e.key === "Tab" || e.key === "Enter") {
              e.preventDefault();
              _select();
              return;
            }
            if (e.key === "ArrowDown") {
              e.preventDefault();
              _idx = (_idx + 1) % _flt.length;
              _renderItems();
              return;
            }
            if (e.key === "ArrowUp") {
              e.preventDefault();
              _idx = (_idx - 1 + _flt.length) % _flt.length;
              _renderItems();
              return;
            }
            if (e.key === "Escape") {
              _hide();
            }
          }
          function _select() {
            var cmd = _flt[_idx];
            if (!cmd) return;
            inp().value = cmd.name;
            _hide();
            inp().focus();
          }
          function _show() {
            if (!_popup) {
              _popup = document.createElement("div");
              _popup.className = "cmd-popup";
              wrap().appendChild(_popup);
            }
            _renderItems();
          }
          function _renderItems() {
            if (!_popup) return;
            _popup.innerHTML = _flt
              .map(function (c, i) {
                return (
                  '<div class="cmd-item' +
                  (i === _idx ? " active" : "") +
                  '" data-idx="' +
                  i +
                  '"><div class="cmd-item-icon">' +
                  c.icon +
                  '</div><div class="cmd-item-text"><div class="cmd-item-name">' +
                  esc(c.name) +
                  '</div><div class="cmd-item-desc">' +
                  esc(c.desc) +
                  '</div></div><span class="cmd-item-key">Tab</span></div>'
                );
              })
              .join("");
            _popup.querySelectorAll(".cmd-item").forEach(function (el) {
              el.addEventListener("mouseenter", function () {
                _idx = parseInt(el.dataset.idx);
                _renderItems();
              });
              el.addEventListener("click", function () {
                _idx = parseInt(el.dataset.idx);
                _select();
              });
            });
          }
          function _hide() {
            if (_popup) {
              _popup.remove();
              _popup = null;
            }
          }
          function tryExec(text) {
            var cmd = text.trim().toLowerCase();
            if (cmd === "/reset") {
              _execReset();
              return true;
            }
            if (cmd === "/history") {
              _execHistory();
              return true;
            }
            return false;
          }
          function _execReset() {
            SE.cancelAll();
            MS.clear();
            RD.clearChat();
            IC2.setBusy(false);
            CN.sendJSON({ type: "command", action: "reset" });
            RD.showBanner("status", "대화가 초기화되었습니다.");
          }
          function _execHistory() {
            RD.hideWel();
            var hist = MS.getSummary();
            if (hist.length === 0) {
              var stored = MS.loadPersisted();
              if (stored.length === 0) {
                RD.render(MS.create("system", "대화 기록이 없습니다."));
                return;
              }
              _renderHL(stored);
              return;
            }
            _renderHL(hist);
          }
          function _renderHL(list) {
            var lines = list.map(function (m) {
              var t = new Date(m.time);
              var ts =
                String(t.getHours()).padStart(2, "0") +
                ":" +
                String(t.getMinutes()).padStart(2, "0");
              var who = m.role === "user" ? "🧑" : "🤖";
              return "[" + ts + "] " + who + " " + m.text;
            });
            var text =
              "── 대화 기록 (" + list.length + "건) ──\n" + lines.join("\n");
            RD.render(MS.create("system", text));
          }
          return { init: init, tryExec: tryExec };
        })();

        /* Utils */
        function sanitizeSVG(code) {
          var doc = new DOMParser().parseFromString(code, "image/svg+xml");
          var svg = doc.querySelector("svg");
          if (!svg) return "";
          svg
            .querySelectorAll("script,foreignObject,iframe,embed,object")
            .forEach(function (e) {
              e.remove();
            });
          svg.querySelectorAll("*").forEach(function (el) {
            Array.from(el.attributes).forEach(function (a) {
              if (
                a.name.toLowerCase().startsWith("on") ||
                a.value.includes("javascript:")
              )
                el.removeAttribute(a.name);
            });
            ["href", "xlink:href"].forEach(function (attr) {
              var v = el.getAttribute(attr);
              if (v && v.trim().toLowerCase().startsWith("javascript:"))
                el.removeAttribute(attr);
            });
          });
          return svg.outerHTML;
        }
        function esc(s) {
          var d = document.createElement("div");
          d.textContent = s;
          return d.innerHTML;
        }
        function sleep(ms) {
          return new Promise(function (r) {
            setTimeout(r, ms);
          });
        }
        function autoScroll() {
          var c = document.getElementById("chatContainer");
          if (c.scrollHeight - c.scrollTop - c.clientHeight < 160)
            c.scrollTop = c.scrollHeight;
        }

        /* App */
        window.App = {
          sendMessage: function () {
            var inp = document.getElementById("messageInput");
            var t = inp.value.trim();
            if (!t) return;
            if (CM.tryExec(t)) {
              inp.value = "";
              return;
            }
            RD.render(MS.create("user", t));
            inp.value = "";
            if (!CN.send(t)) {
              RD.showBanner("error", "서버에 연결되어 있지 않습니다.");
              return;
            }
            IC2.setBusy(true);
            ED.startBusyTimer();
          },
          sendExample: function (btn) {
            document.getElementById("messageInput").value =
              btn.textContent.trim();
            this.sendMessage();
          },
          cancelStream: function () {
            SE.cancelAll();
            var id = ED.getCurrentId();
            if (id) {
              MS.update(id, {
                status: "done",
                showThinking: false,
                progressCollapsed: true,
              });
              var m = MS.get(id);
              if (m) {
                m.progressElapsed = m.progressStartTime
                  ? (Date.now() - m.progressStartTime) / 1000
                  : null;
                RD.render(m);
              }
            }
            IC2.setBusy(false);
          },
          toggleTheme: function () {
            TM.toggle();
          },
          downloadSVG: function (btn) {
            var svg = btn.closest(".viz-container");
            svg = svg ? svg.querySelector("svg") : null;
            if (!svg) return;
            var b = new Blob([svg.outerHTML], { type: "image/svg+xml" });
            var u = URL.createObjectURL(b);
            var a = document.createElement("a");
            a.href = u;
            a.download = "data-copilot-chart.svg";
            a.click();
            URL.revokeObjectURL(u);
          },
        };
        TM.init();
        CM.init();
        CN.connect();
      })();
    </script>
  </body>
</html>
