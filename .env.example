# LLM Provider: "anthropic" / "openai_compatible" (Groq/OpenRouter) / "ibk_custom" (폐쇄망)
LLM_PROVIDER=anthropic

# Anthropic API (LLM_PROVIDER=anthropic 일 때 사용)
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI Compatible API (LLM_PROVIDER=openai_compatible 일 때 사용)
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── IBK Custom LLM Gateway (LLM_PROVIDER=ibk_custom 일 때 사용) ──
# 내부 LLM 관리툴에 프롬프트를 단일 placeholder(예: {{prompt}})로 등록하고,
# 코드가 조립한 system+messages 를 extra[IBK_PLACEHOLDER_NAME] 에 통째로 전달한다.
# IBK_BASE_URL=http://dibkpgt.ibk.co.kr:35001
# IBK_TOKEN=your-ibk-gateway-token
# IBK_PLACEHOLDER_NAME=prompt
# IBK_DEFAULT_TIMEOUT=60.0

# ── LLM 서킷브레이커 (외부 API 연속 실패 시 fast-fail) ──
# False 로 설정하면 CB 가 투명 통과 (기존 동작). 기본 True.
LLM_CB_ENABLED=true
LLM_CB_FAIL_THRESHOLD=5            # 연속 실패 N회 이상 시 OPEN
LLM_CB_RESET_TIMEOUT_SEC=30.0      # OPEN → HALF_OPEN 대기 시간(초)

# ── 임베딩 / Reranker ──
# FP16: GPU 환경에서만 true, CPU 환경에서는 반드시 false
#
# [온라인 개발] HF hub ID 사용, cache_path 에 로컬 캐시
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_CACHE_PATH=/path/to/cache/embedding
#   RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#   RERANKER_CACHE_PATH=/path/to/cache/reranker
#   RERANKER_ONNX_PATH=             (빈 값 → 첫 기동 시 자동 변환)
#
# [폐쇄망] 번들에 포함된 로컬 모델 디렉토리를 직접 지정
#   EMBEDDING_MODEL=/opt/bdp/data-copilot/models/bge-m3
#   EMBEDDING_CACHE_PATH=           (불필요)
#   RERANKER_MODEL=/opt/bdp/data-copilot/models/bge-reranker-v2-m3
#   RERANKER_CACHE_PATH=            (불필요)
#   RERANKER_ONNX_PATH=/opt/bdp/data-copilot/models/bge-reranker-v2-m3/onnx/model.onnx
#
EMBEDDING_USE_FP16=false
EMBEDDING_CACHE_PATH=
RERANKER_ENABLED=true
RERANKER_USE_FP16=false
RERANKER_CACHE_PATH=
RERANKER_TOP_K=10
RERANKER_ONNX_PATH=

# ── HuggingFace 오프라인 모드 (폐쇄망 필수) ──
# 폐쇄망에서는 아래 두 값을 반드시 1로 설정하여 허브 접속 시도를 차단한다.
# 온라인 개발 환경에서는 주석 처리하거나 공란으로 둔다.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Dummy 모드 (true: 내장 샘플 데이터, false: 실제 인프라 연결)
USE_DUMMY=true

# ── 업무 DB 라우팅 ──
# TARGET_DB_CODE: 강제 타깃 시스템 코드 (ADW/BDP/CRP 중 하나).
# 비우면 SELECTED 테이블 기반 동적 결정.
TARGET_DB_CODE=ADW
# SYSTEM_DB_OVERRIDES: 시스템 코드 → 실제 커넥터명 override (JSON dict).
# 외부망 테스트에서 ADW 질의를 PostgreSQL(TEST)로 우회할 때 사용.
# 폐쇄망은 비우거나 {} 로 두면 identity 매핑 (ADW→ADW, BDP→BDP, CRP→CRP).
SYSTEM_DB_OVERRIDES={"ADW":"TEST"}

# PostgreSQL (개발/테스트용 DB - 읽기 전용, 폐쇄망 전환 시 제거)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=test_db
TEST_DB_USER=readonly_user
TEST_DB_PASSWORD=your-password

# PostgreSQL (공통 DB - SQL 이력·체크포인터 등)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=postgres_db
POSTGRES_DB_USER=postgres_user
POSTGRES_DB_PASSWORD=your-password

# Qdrant (업무 매뉴얼 + SQL 수행이력)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MongoDB (테이블 메타 + 코드 메타 + 비즈 메타)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=your-password
MONGO_DATABASE=meta_db

# Neo4j (온톨로지 그래프 — 테이블 관계/JOIN 경로/계수산출식)
# 타겟: Neo4j 5.26 LTS (driver neo4j>=5.20.0)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# Redis (CancelStore/ActiveRunStore — 멀티 워커 시 필수)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis 백엔드: "memory" (단일 워커, 기본값) 또는 "redis" (멀티 워커 운영)
REDIS_BACKEND=memory

# Evaluation Tracker (자체 트래킹, 폐쇄망 호환)
EVAL_TRACKER_ENABLED=true
EVAL_TRACKER_OUTPUT_DIR=logs/traces

# Gunicorn (운영 서버, Linux 전용 — Windows에서는 uvicorn 단독 사용)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120

# Application
LOG_LEVEL=INFO
LOG_FORMAT=console
MAX_QUERY_ROWS=10000

# PII 마스킹 (false: 감사/원본 데이터 보존을 위해 로그·트레이스·응답에서 마스킹 비활성화)
# 은행 감사 요건상 기본 false. true 로 바꾸면 전화/이메일/주민번호/카드번호 등 마스킹 적용.
PII_MASKING_ENABLED=false

# 스트리밍 마스터 킬스위치 (true: 클라이언트 streaming 플래그 무시하고 강제 OFF)
# 폐쇄망 LLM 스트리밍 불안정 시 운영 측에서 즉시 차단 가능.
STREAMING_DISABLED=false

# Qdrant 임베딩 계산 ThreadPool 워커 수 (CPU/GPU 코어 여유 고려)
QDRANT_EMBED_WORKERS=2

# Postgres Checkpointer search_path (스키마 우선순위)
CHECKPOINTER_SEARCH_PATH=bdptbl,public

# 세션당 브로드캐스트 대기 메시지 버퍼 상한 (OOM 방지)
MESSAGE_STORE_PENDING_MAX=50

# Neo4j 온톨로지 LRU 캐시 상한 (엔트리 수, 메모리 누수 방지)
NEO4J_CACHE_MAX_ENTRIES=512

# ============================================================
# 폐쇄망 전용 DB (온라인 개발 시에는 주석 유지)
# ============================================================

# Impala (Cloudera CDP 7.1.9)
# IMPALA_HOST=impala-server.internal
# IMPALA_PORT=21050
# IMPALA_AUTH=LDAP
# IMPALA_USER=your-ldap-user
# IMPALA_PASSWORD=your-ldap-password
# IMPALA_DATABASE=default

# Sybase IQ 16.1
# SYBASE_HOST=sybase-server.internal
# SYBASE_PORT=2638
# SYBASE_USER=your-user
# SYBASE_PASSWORD=your-password
# SYBASE_DATABASE=your-database
# SYBASE_ODBC_DRIVER=SQL Anywhere 16

# Oracle 19c (CRP)
# thin 모드가 기본. thick 모드는 Instant Client 별도 반입 필요.
# ORACLE_HOST=oracle-server.internal
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=your-service
# ORACLE_USER=your-user
# ORACLE_PASSWORD=your-password
# ORACLE_DEFAULT_SCHEMA=
# ORACLE_THICK_MODE=false
