# LLM Provider: "anthropic" 또는 "openai_compatible" (Groq, OpenRouter 등)
LLM_PROVIDER=anthropic

# Anthropic API (LLM_PROVIDER=anthropic 일 때 사용)
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI Compatible API (LLM_PROVIDER=openai_compatible 일 때 사용)
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 임베딩 / Reranker (환경별 차이가 있는 값만) ──
# FP16: GPU 환경에서만 true, CPU 환경에서는 반드시 false
EMBEDDING_USE_FP16=false
EMBEDDING_CACHE_PATH=
RERANKER_ENABLED=true
RERANKER_USE_FP16=false
RERANKER_CACHE_PATH=
RERANKER_TOP_K=10

# Dummy 모드 (true: 내장 샘플 데이터, false: 실제 인프라 연결)
USE_DUMMY=true

# ── 업무 DB 라우팅 ──
# TARGET_DB_CODE: 강제 타깃 시스템 코드 (ADW/BDP/CRP 중 하나).
# 비우면 SELECTED 테이블 기반 동적 결정.
TARGET_DB_CODE=ADW
# SYSTEM_DB_OVERRIDES: 시스템 코드 → 실제 커넥터명 override (JSON dict).
# 외부망 테스트에서 ADW 질의를 PostgreSQL(TEST)로 우회할 때 사용.
# 폐쇄망은 비우거나 {} 로 두면 identity 매핑 (ADW→ADW, BDP→BDP, CRP→CRP).
SYSTEM_DB_OVERRIDES={"ADW":"TEST"}

# PostgreSQL (개발/테스트용 DB - 읽기 전용, 폐쇄망 전환 시 제거)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=test_db
TEST_DB_USER=readonly_user
TEST_DB_PASSWORD=your-password

# PostgreSQL (공통 DB - SQL 이력·체크포인터 등)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=postgres_db
POSTGRES_DB_USER=postgres_user
POSTGRES_DB_PASSWORD=your-password

# Qdrant (업무 매뉴얼 + SQL 수행이력)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MongoDB (테이블 메타 + 코드 메타 + 비즈 메타)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=your-password
MONGO_DATABASE=meta_db

# Redis (CancelStore/ActiveRunStore — 멀티 워커 시 필수)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis 백엔드: "memory" (단일 워커, 기본값) 또는 "redis" (멀티 워커 운영)
REDIS_BACKEND=memory

# Evaluation Tracker (자체 트래킹, 폐쇄망 호환)
EVAL_TRACKER_ENABLED=true
EVAL_TRACKER_OUTPUT_DIR=logs/traces

# Gunicorn (운영 서버, Linux 전용 — Windows에서는 uvicorn 단독 사용)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120

# Application
LOG_LEVEL=INFO
LOG_FORMAT=console
MAX_QUERY_ROWS=10000

# ============================================================
# 폐쇄망 전용 DB (온라인 개발 시에는 주석 유지)
# ============================================================

# Impala (Cloudera CDP 7.1.9)
# IMPALA_HOST=impala-server.internal
# IMPALA_PORT=21050
# IMPALA_AUTH=LDAP
# IMPALA_USER=your-ldap-user
# IMPALA_PASSWORD=your-ldap-password
# IMPALA_DATABASE=default

# Sybase IQ 16.1
# SYBASE_HOST=sybase-server.internal
# SYBASE_PORT=2638
# SYBASE_USER=your-user
# SYBASE_PASSWORD=your-password
# SYBASE_DATABASE=your-database
# SYBASE_ODBC_DRIVER=SQL Anywhere 16
