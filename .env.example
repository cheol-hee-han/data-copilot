# LLM Provider: "anthropic" 또는 "openai_compatible" (Groq, OpenRouter 등)
LLM_PROVIDER=anthropic

# Anthropic API (LLM_PROVIDER=anthropic 일 때 사용)
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI Compatible API (LLM_PROVIDER=openai_compatible 일 때 사용)
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 임베딩 / Reranker (환경별 차이가 있는 값만) ──
# FP16: GPU 환경에서만 true, CPU 환경에서는 반드시 false
EMBEDDING_USE_FP16=false
EMBEDDING_CACHE_PATH=
RERANKER_ENABLED=true
RERANKER_USE_FP16=false
RERANKER_CACHE_PATH=
RERANKER_TOP_K=10

# Dummy 모드 (true: 내장 샘플 데이터, false: 실제 인프라 연결)
USE_DUMMY=true

# 배포 모드: "external" (외부망, PostgreSQL) | "internal" (내부망, ADW+BDP)
DEPLOYMENT_MODE=external

# PostgreSQL (정보계 DB - 읽기 전용)
INFO_DB_HOST=localhost
INFO_DB_PORT=5432
INFO_DB_NAME=info_db
INFO_DB_USER=readonly_user
INFO_DB_PASSWORD=your-password

# PostgreSQL (SQL 이력 DB)
HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=history_db
HISTORY_DB_USER=history_user
HISTORY_DB_PASSWORD=your-password

# ElasticSearch (메타 + 보고서)
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your-password

# Qdrant (업무 매뉴얼 + SQL 수행이력)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MongoDB (테이블 메타 + 코드 메타 + 비즈 메타)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=your-password
MONGO_DATABASE=meta_db

# Redis (세션 캐시 + 명확화 상태)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 세션 백엔드: "memory" (인메모리 dict, 개발용) 또는 "redis" (운영 권장)
SESSION_BACKEND=memory

# LangSmith (외부망 개발 환경 전용, 폐쇄망에서는 false로 설정)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Evaluation Tracker (자체 트래킹, 폐쇄망 호환)
EVAL_TRACKER_ENABLED=true
EVAL_TRACKER_OUTPUT_DIR=logs/traces

# Gunicorn (운영 서버, Linux 전용 — Windows에서는 uvicorn 단독 사용)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120

# Application
LOG_LEVEL=INFO
LOG_FORMAT=console
MAX_QUERY_ROWS=10000

# ============================================================
# 폐쇄망 전용 DB (온라인 개발 시에는 주석 유지)
# ============================================================

# Impala (Cloudera CDP 7.1.9)
# IMPALA_HOST=impala-server.internal
# IMPALA_PORT=21050
# IMPALA_AUTH=LDAP
# IMPALA_USER=your-ldap-user
# IMPALA_PASSWORD=your-ldap-password
# IMPALA_DATABASE=default

# Sybase IQ 16.1
# SYBASE_HOST=sybase-server.internal
# SYBASE_PORT=2638
# SYBASE_USER=your-user
# SYBASE_PASSWORD=your-password
# SYBASE_DATABASE=your-database
# SYBASE_ODBC_DRIVER=SQL Anywhere 16
