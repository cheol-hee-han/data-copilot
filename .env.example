# LLM Provider: "anthropic" 또는 "openai_compatible" (Groq, OpenRouter 등)
LLM_PROVIDER=anthropic

# Anthropic API (LLM_PROVIDER=anthropic 일 때 사용)
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI Compatible API (LLM_PROVIDER=openai_compatible 일 때 사용)
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# ── 임베딩 모델 (BGE-M3, Dense + Sparse 하이브리드) ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# FP16: GPU 환경에서만 true, CPU 환경에서는 반드시 false
EMBEDDING_USE_FP16=false
EMBEDDING_CACHE_PATH=
EMBEDDING_BATCH_SIZE=64

# ── Reranker (BGE-Reranker-v2-m3, Cross-Encoder) ──
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# FP16: GPU 환경에서만 true, CPU 환경에서는 반드시 false
RERANKER_USE_FP16=false
RERANKER_CACHE_PATH=
RERANKER_TOP_K=10

# ── Reranker CPU 최적화 (ONNX Runtime) ──
# 백엔드: "pytorch" (기본 PyTorch) 또는 "onnx" (ONNX Runtime CPU 최적화)
RERANKER_BACKEND=onnx
# ONNX 모델 경로 (빈 문자열이면 PyTorch 모델에서 자동 변환, 최초 1회)
RERANKER_ONNX_PATH=
# INT8 동적 양자화 (CPU 2.5~3.5x 가속, 품질 손실 <1%)
RERANKER_QUANTIZE=true
# CPU 스레드 수 (0 = 물리 코어 수 자동 감지)
# 권장: 서버 = 물리코어수, 개발PC = 물리코어수/2
RERANKER_CPU_THREADS=0
# 사전 필터링: 벡터 스코어 하위 후보 제거 (0.0 = 비활성화)
# 금융 도메인 권장: 0.15~0.25 (보수적으로 시작 후 튜닝)
RERANKER_SCORE_THRESHOLD=0.0
# 사전 필터링 후 최소 보장 후보 수
RERANKER_MIN_CANDIDATES=15

# LLM 호출 설정
LLM_PARSE_MAX_RETRY=2
LLM_DEFAULT_MAX_TOKENS=200
LLM_DEFAULT_TIMEOUT=15.0
LLM_LONG_TIMEOUT=30.0
LLM_CONTEXT_TIMEOUT=60.0
LLM_FORMAT_MAX_TOKENS=2000
LLM_SVG_MAX_TOKENS=4000
LLM_CONCURRENCY_LIMIT=3

# Dummy 모드 (true: 내장 샘플 데이터, false: 실제 인프라 연결)
USE_DUMMY=true

# 파이프라인 제어
SQL_MAX_RETRY=2
CLARIFICATION_MAX_TURNS=2
MAX_INPUT_LENGTH=500
MAX_SESSIONS=1000
MIN_DESCRIPTION_LENGTH=20
MIN_ROWS_FOR_VISUALIZATION=3
FORMAT_MAX_ROWS=50

# PostgreSQL (정보계 DB - 읽기 전용)
INFO_DB_HOST=localhost
INFO_DB_PORT=5432
INFO_DB_NAME=info_db
INFO_DB_USER=readonly_user
INFO_DB_PASSWORD=your-password

# PostgreSQL (SQL 이력 DB)
HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=history_db
HISTORY_DB_USER=history_user
HISTORY_DB_PASSWORD=your-password

# ElasticSearch (메타 + 보고서)
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your-password
ES_TABLE_META_INDEX=table_meta
ES_REPORT_SQL_INDEX=report_sql
ES_CODE_META_INDEX=code_meta
ES_TABLE_META_SIZE=10
ES_REPORT_SQL_SIZE=5
ES_CODE_META_SIZE=20

# Qdrant (업무 매뉴얼 + SQL 수행이력)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SEARCH_TOP_K=3
QDRANT_COLLECTION_NAME=biz_manual
QDRANT_SQL_HISTORY_COLLECTION=sql_history
QDRANT_SQL_HISTORY_TOP_K=10
QDRANT_SQL_HISTORY_PREFETCH_LIMIT=50

# MongoDB (테이블 메타 + 코드 메타 + 비즈 메타)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=your-password
MONGO_DATABASE=meta_db
MONGO_TABLE_META_COLLECTION=table_meta
MONGO_CODE_META_COLLECTION=code_meta
MONGO_BIZ_META_COLLECTION=biz_meta
MONGO_REQUEST_TIMEOUT=10

# Redis (세션 캐시 + 명확화 상태)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 세션 백엔드: "memory" (인메모리 dict, 개발용) 또는 "redis" (운영 권장)
SESSION_BACKEND=memory
SESSION_TTL=1800
SESSION_CLARIFY_TTL=300
SESSION_MAX_HISTORY=20

# LangSmith (외부망 개발 환경 전용, 폐쇄망에서는 false로 설정)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Evaluation Tracker (자체 트래킹, 폐쇄망 호환)
EVAL_TRACKER_ENABLED=true
EVAL_TRACKER_OUTPUT_DIR=evaluation/traces

# Application
LOG_LEVEL=INFO
LOG_FORMAT=console
MAX_QUERY_ROWS=10000

# 3순위: SVG 차트 레이아웃 (프론트엔드에서 조절하는 게 맞아 변경 빈도 낮음)
CHART_WIDTH=600
CHART_HEIGHT=400
CHART_MARGIN_LEFT=80
CHART_MARGIN_RIGHT=40
CHART_MARGIN_TOP=60
CHART_MARGIN_BOTTOM=70

# 3순위: 로그 미리보기 (내부 디버깅용, 자주 안 바뀜)
LOG_LONG_VALUE_THRESHOLD=80
LOG_SEPARATOR_WIDTH=72

# 3순위: 금액 단위 기준값 (한국 금융 고정, 바뀔 일 없음)
KRW_EOK_THRESHOLD=100000000
KRW_MAN_THRESHOLD=10000

# ============================================================
# 폐쇄망 전용 DB (온라인 개발 시에는 주석 유지)
# ============================================================

# Impala (Cloudera CDP 7.1.9)
# IMPALA_HOST=impala-server.internal
# IMPALA_PORT=21050
# IMPALA_AUTH=LDAP
# IMPALA_USER=your-ldap-user
# IMPALA_PASSWORD=your-ldap-password
# IMPALA_DATABASE=default

# Sybase IQ 16.1
# SYBASE_HOST=sybase-server.internal
# SYBASE_PORT=2638
# SYBASE_USER=your-user
# SYBASE_PASSWORD=your-password
# SYBASE_DATABASE=your-database
# SYBASE_ODBC_DRIVER=SQL Anywhere 16
