    {
      "id": "REC-ASK-03",
      "name": "ask_user 후 사용자 응답별 분기",
      "description": "사용자 응답이 유효/불명확/모르겠다일 때 recovery_agent 재진입 후 행동 검증.",
      "expected_path": "recovery_agent → ask_user → 사용자 응답 → recovery_agent 재진입 → replan/give_up",
      "cases": [
        {
          "id": "RA03-001",
          "query": "고객 수 알려줘",
          "scenario": "사용자가 명확한 선택지 응답",
          "ask_user_question": "어떤 고객을 대상으로 하시나요?",
          "ask_user_options": ["개인고객", "기업고객", "전체"],
          "user_response": "기업고객",
          "expected_after_response": {
            "action": "replan",
            "hypothesis_contains": "기업고객|법인|CUS_DCD",
            "replan_count_change": 0
          },
          "verify": {
            "is_clarification_reentry": true,
            "increment_replan_skipped": true,
            "hypothesis_transition_skipped": true,
            "clarification_history_injected": true
          },
          "notes": "재진입 시 replan_count 미증가, 가설 전이 스킵, clarification_history 포함 확인."
        },
