            "dead_ends": [
              {"hypothesis": "매뉴얼에서 DSR 산출식 확인", "result": "search_manual('DSR 총부채원리금상환비율') → 0건"},
              {"hypothesis": "유사 SQL에서 DSR 계산 패턴 확인", "result": "search_use_cases('연간 원리금 상환액을 연소득으로 나누어 DSR을 산출') → 0건"}
