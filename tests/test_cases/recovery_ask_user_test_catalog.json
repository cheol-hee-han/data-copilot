{
  "version": "1.0",
  "created": "2026-04-17",
  "description": "recovery_agent ask_user 기능 테스트 카탈로그 — 탐색 실패 후 사용자 명확화 질문이 발생하는 시나리오",
  "target": "Docker 데이터소스(PG/Qdrant/MongoDB) + LLM API",
  "total_cases": 30,
  "design_context": {
    "trigger_condition": "recovery_agent가 동일 항목에 대해 2회+ 탐색 실패 시 ask_user 또는 give_up 판단",
    "ask_user_vs_give_up": "ask_user=사용자 업무 판단으로 해소 가능, give_up=데이터 부재·SQL 불가",
    "max_ask_user_rounds": 2,
    "infrastructure": "AmbiguitySignal → pending_signals → clarification_handler → interrupt → 사용자 응답 → resolved_signals → recovery_agent 재진입"
  },
  "categories": [
    {
      "id": "REC-ASK-01",
      "name": "대상 범위 불명 (single_select)",
      "description": "유효 후보가 복수 발견되었으나 탐색으로 특정 불가. 사용자 선택 필요.",
      "expected_path": "explore → readiness_gate(REPLAN) → recovery_agent(2회 탐색) → ask_user(single_select) → 사용자 응답 → recovery_agent(replan)",
      "cases": [
        {
          "id": "RA01-001",
          "query": "고객 수 알려줘",
          "recovery_context": {
            "unresolved_item": "scope:고객범위",
            "explored_tables": ["TB_ADW_CSC101M"],
            "dead_ends": [
              {"hypothesis": "CUS_DCD='01' 개인고객 기준", "result": "개인/법인/개인사업자 3종 모두 유효"},
              {"hypothesis": "유사 SQL에서 기본 고객 범위 확인", "result": "개인 2건, 법인 1건, 전체 1건 — 편중 불가"}
            ],
            "failure_type": "필터값 불명"
          },
          "expected_ask_user": {
            "question_type": "single_select",
            "question_pattern": "어떤 고객.*대상",
            "expected_options": ["개인고객", "기업고객(법인)", "전체"],
            "option_source": "CUS_DCD 코드 메타: 01=개인, 02=법인, 03=개인사업자"
          },
          "user_response": "개인고객이요",
          "expected_after_response": {
            "action": "replan",
            "clarified_filter": "CUS_DCD = '01'",
            "expected_tables": ["TB_ADW_CSC101M"]
          },
          "notes": "CAT-06 E06-001과 유사하나, CAT-06은 정규화 단계 명확화. 이 케이스는 recovery 단계에서 탐색 2회 실패 후 발생."
        },
        {
          "id": "RA01-002",
          "query": "잔액 합계 알려줘",
          "recovery_context": {
            "unresolved_item": "scope:잔액범위",
            "explored_tables": ["TB_ADW_DEP201P", "TB_ADW_LNB301M"],
            "dead_ends": [
              {"hypothesis": "수신 잔액(DEP201P.BAL_AMT) 기준", "result": "수신/여신 모두 유효"},
              {"hypothesis": "유사 SQL에서 '잔액 합계' 기본 대상 확인", "result": "수신 3건, 여신 2건 — 편중 불가"}
            ],
            "failure_type": "필터값 불명"
          },
          "expected_ask_user": {
            "question_type": "single_select",
            "question_pattern": "잔액.*어떤.*대상|예금.*대출",
            "expected_options": ["예금(수신) 잔액", "대출(여신) 잔액", "전체 (예금+대출)"]
          },
          "user_response": "예금 잔액이요",
          "expected_after_response": {
            "action": "replan",
            "clarified_filter": "DEP201P.BAL_AMT 사용",
            "expected_tables": ["TB_ADW_DEP201P"]
          },
          "notes": "수신(DEP201P) vs 여신(LNB301M) 중 어느 잔액인지 불명."
        },
        {
          "id": "RA01-003",
          "query": "등급별 현황 뽑아줘",
          "recovery_context": {
            "unresolved_item": "scope:등급기준",
            "explored_tables": ["TB_ADW_CSC101M", "TB_ADW_CSP103M"],
            "dead_ends": [
              {"hypothesis": "CUS_GRD_CD(고객등급) 기준", "result": "CUS_GRD_CD, MKT_GRD_CD 모두 등급 컬럼"},
              {"hypothesis": "유사 SQL에서 '등급별 현황' 패턴 확인", "result": "고객등급 3건, 마케팅등급 1건 — 편중 불충분"}
            ],
            "failure_type": "필터값 불명"
          },
          "expected_ask_user": {
            "question_type": "single_select",
            "question_pattern": "어떤 등급.*기준",
            "expected_options": ["고객등급 (VIP/우수/일반/잠재/관리)", "마케팅등급 (최우수/우수/일반/관심/휴면)"],
            "option_source": "CUS_GRD_CD vs MKT_GRD_CD"
          },
          "user_response": "고객등급 기준이요",
          "expected_after_response": {
            "action": "replan",
            "clarified_filter": "CUS_GRD_CD 기준 GROUP BY"
          },
          "notes": "고객등급(CSC101M.CUS_GRD_CD) vs 마케팅등급(CSP103M.MKT_GRD_CD) 선택 불가."
        },
        {
          "id": "RA01-004",
          "query": "연체 건수 알려줘",
          "recovery_context": {
            "unresolved_item": "filter:연체판정기준",
            "explored_tables": ["TB_ADW_LNB301M"],
            "dead_ends": [
              {"hypothesis": "OVDU_GRD_CD IS NOT NULL 기준", "result": "OVDU_GRD_CD='A'가 정상. B~E가 연체"},
              {"hypothesis": "LN_STCD='03' 연체 상태 기준", "result": "LN_STCD 03=연체도 유효한 기준"}
            ],
            "failure_type": "필터값 불명"
          },
          "expected_ask_user": {
            "question_type": "single_select",
            "question_pattern": "연체.*기준|어떤.*연체",
            "expected_options": ["연체등급 기준 (요주의 이상)", "대출상태 기준 (연체 상태)", "연체일수 기준 (1일 이상)"],
            "option_source": "OVDU_GRD_CD B~E vs LN_STCD='03' vs OVDU_DY_CN>0"
          },
          "user_response": "연체등급 기준으로요",
          "expected_after_response": {
            "action": "replan",
            "clarified_filter": "OVDU_GRD_CD IN ('B','C','D','E')"
          },
          "notes": "연체 판정 기준이 3가지(등급/상태/일수) 있어 특정 불가."
        },
        {
          "id": "RA01-005",
          "query": "지역별 대출 현황",
          "recovery_context": {
            "unresolved_item": "filter:지역필터방식",
            "explored_tables": ["TB_ADW_LNB301M", "TB_ADW_COM001M"],
            "dead_ends": [
              {"hypothesis": "COM001M.RGN_CD(지역코드) 기준 JOIN", "result": "RGN_CD와 BR_NM 양쪽 경로 가능"},
              {"hypothesis": "BR_NM LIKE '%서울%' 텍스트 기준", "result": "광역시/도 단위인지 시군구 단위인지 불명"}
            ],
            "failure_type": "필터값 불명"
          },
          "expected_ask_user": {
            "question_type": "single_select",
            "question_pattern": "지역.*단위|어떤.*지역",
            "expected_options": ["광역시/도 단위 (서울, 경기, 부산 등)", "개별 지점 단위"]
          },
          "user_response": "광역시/도 단위요",
          "expected_after_response": {
            "action": "replan",
            "clarified_filter": "RGN_CD 기준 GROUP BY"
          },
          "notes": "RGN_CD 12개 코드(서울~경남) 기반 vs BR_NM 텍스트 기반 집계 범위 불명."
        }
      ]
    },
    {
      "id": "REC-ASK-02",
      "name": "산출식/계산 기준 불명 (free_text)",
      "description": "금융 지표 산출식이 매뉴얼·유사SQL에서 확인 불가. 사용자에게 직접 질문.",
      "expected_path": "explore → readiness_gate(REPLAN) → recovery_agent(2회 탐색 실패) → ask_user(free_text) → 사용자 응답 → recovery_agent(replan)",
      "cases": [
        {
          "id": "RA02-001",
          "query": "BIS 비율 산출해줘",
          "recovery_context": {
            "unresolved_item": "measure:BIS비율산출식",
            "explored_tables": ["TB_ADW_RSK1101M"],
            "dead_ends": [
              {"hypothesis": "매뉴얼에서 BIS 비율 산출식 확인", "result": "search_manual('BIS 비율 산출식') → 0건"},
              {"hypothesis": "유사 SQL에서 BIS 비율 계산 패턴 확인", "result": "search_use_cases('BIS 비율을 자기자본과 위험가중자산으로 산출') → 0건"}
            ],
            "failure_type": "산출식 불명"
          },
          "expected_ask_user": {
            "question_type": "free_text",
            "question_pattern": "BIS.*어떤.*방식|산출.*기준|계산",
