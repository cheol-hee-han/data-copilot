{
  "_comment": "dpasset_table + dpasset_column 조인 — 테이블/컬럼 메타 조회",
  "_note": "$match 단계는 코드에서 동적으로 구성 (text 검색 / 테이블명 exact match)",
  "lookup": {
    "$lookup": {
      "from": "${column_meta_collection}",
      "localField": "name",
      "foreignField": "table_name",
      "as": "columns_raw"
    }
  },
  "project": {
    "$project": {
      "_id": 0,
      "name": 1,
      "alt_name": {"$ifNull": ["$alt_name", ""]},
      "description": {"$ifNull": ["$desc", ""]},
      "schema_name": 1,
      "columns": {
        "$map": {
          "input": "$columns_raw",
          "as": "col",
          "in": {
            "name": "$$col.name",
            "alt_name": {"$ifNull": ["$$col.column_alt_name", ""]},
            "type": {"$ifNull": ["$$col.column_type", ""]},
            "description": {"$ifNull": ["$$col.column_desc", ""]},
            "is_pk": {"$ifNull": ["$$col.column_pk", false]}
          }
        }
      }
    }
  }
}
